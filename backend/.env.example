# Environment
NODE_ENV=development

# Server
PORT=3000
SERVE_WEB=false
# Set the exact HTTPS Conveyor URL when publishing; no trailing slash.
PUBLIC_ORIGIN=

# Database
MONGODB_URI=mongodb://signvoice:dev_password@localhost:27017/signvoice?authSource=admin

# Gmail SMTP: use a Google App Password, not the Gmail sign-in password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional HTTPS web origin override. By default use PUBLIC_ORIGIN / WEB_ORIGIN.
PASSWORD_RESET_ORIGIN=

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your_very_long_random_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=your_very_long_random_refresh_secret_different_from_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
WEB_ORIGIN=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# OAuth2 (Configure when ready)
GOOGLE_CLIENT_ID=your_google_client_id_from_console
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Logging
LOG_LEVEL=debug

# Development Admin (FOR DEVELOPMENT ONLY)
ADMIN_EMAIL=admin@signvoice.local
ADMIN_PASSWORD=admin123456
