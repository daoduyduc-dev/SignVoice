# Environment
NODE_ENV=development

# Server
PORT=3000
SERVE_WEB=false
# Set the exact HTTPS Conveyor URL when publishing; no trailing slash.
PUBLIC_ORIGIN=

# Database
MONGODB_URI=mongodb://signvoice:dev_password@localhost:27017/signvoice?authSource=admin

# Gmail SMTP: use a Google App Password, not the Gmail sign-in password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional HTTPS web origin override. By default use PUBLIC_ORIGIN / WEB_ORIGIN.
PASSWORD_RESET_ORIGIN=

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your_very_long_random_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=your_very_long_random_refresh_secret_different_from_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
WEB_ORIGIN=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# OAuth2 (Configure when ready)
OAUTH_BACKEND_ORIGIN=http://localhost:3000
OAUTH_FRONTEND_ORIGIN=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Set the Graph API version supported by your Meta app, e.g. v25.0 (verify in app dashboard).
FACEBOOK_GRAPH_API_VERSION=
# Optional overrides: must match backend origin and fixed callback path exactly.
GOOGLE_CALLBACK_URL=
FACEBOOK_CALLBACK_URL=
# Integer 60..900 seconds; default 600
OAUTH_STATE_TTL_SECONDS=600

# Logging
LOG_LEVEL=debug

# Development Admin (FOR DEVELOPMENT ONLY)
ADMIN_EMAIL=admin@signvoice.local
ADMIN_PASSWORD=admin123456
